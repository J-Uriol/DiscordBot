# ============================================================
#  .env.example — Copia este archivo a .env y rellena los valores
# ============================================================

# ── Token del bot de Discord ─────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# ── IDs de canales ───────────────────────────────────────────
WELCOME_CHANNEL_ID=123456789012345678
WARN_CHANNEL_ID=123456789012345678
ECO_CHANNEL_ID=123456789012345678

# ── IDs de categorías / roles ────────────────────────────────
TICKET_CATEGORY_ID=123456789012345678
MOD_ROLE_ID=123456789012345678
# Lista separada por comas de los IDs de roles automáticos al entrar
ROLES_IDS=123456789012345678,123456789012345679

# ── Usuario protegido (no puede ser mencionado por usuarios normales) ─
# Deja en blanco o elimina si no necesitas esta función
USER_ID_NO_MENCIONAR=

# ── Nombre y presencia del bot ───────────────────────────────
BOT_STREAMING_NAME=Tu Bot
BOT_STREAMING_URL=https://www.twitch.tv/tu_canal

# ── Mensaje de bienvenida ────────────────────────────────────
SERVER_NAME=Mi Servidor
WELCOME_IMAGE_URL=https://example.com/welcome_banner.jpg
SERVER_LOGO_URL=https://example.com/logo.jpg

# ── Economía ─────────────────────────────────────────────────
DAILY_AMOUNT=200
WORK_MIN=100
WORK_MAX=500
